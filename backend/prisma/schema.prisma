generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  SUSPENDED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  DROPPED
}

enum CertificateStatus {
  VALID
  REVOKED
}

model User {
  id           String     @id @default(uuid())
  fullName     String     @db.VarChar(191)
  email        String     @unique @db.VarChar(191)
  phone        String?    @db.VarChar(50)
  passwordHash String     @db.VarChar(255)
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  studentProfile       Student?
  staffProfile         Staff?
  coursesCreated       Course[]       @relation("CourseCreator")
  enrollmentsReviewed  Enrollment[]   @relation("EnrollmentReviewer")
  certificatesIssued   Certificate[]  @relation("CertificateIssuer")
  auditLogs            AuditLog[]

  @@index([role])
  @@index([status])
}

model Student {
  id                    String        @id @default(uuid())
  userId                String?       @unique
  studentNumber         String        @unique @db.VarChar(50)
  fullName              String        @db.VarChar(191)
  email                 String?       @db.VarChar(191)
  phone                 String?       @db.VarChar(50)
  dateOfBirth           DateTime?     @db.Date
  gender                String?       @db.VarChar(20)
  address               String?       @db.Text
  emergencyContactName  String?       @db.VarChar(191)
  emergencyContactPhone String?       @db.VarChar(50)
  status                StudentStatus @default(ACTIVE)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  certificates Certificate[]

  @@index([studentNumber])
  @@index([status])
}

model Staff {
  id          String      @id @default(uuid())
  userId      String      @unique
  staffNumber String      @unique @db.VarChar(50)
  jobTitle    String      @db.VarChar(100)
  department  String?     @db.VarChar(100)
  status      StaffStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([staffNumber])
  @@index([status])
}

model Course {
  id          String       @id @default(uuid())
  courseCode  String       @unique @db.VarChar(50)
  title       String       @db.VarChar(191)
  description String       @db.Text
  duration    String       @db.VarChar(100)
  schedule    String       @db.VarChar(191)
  fee         Decimal      @db.Decimal(10, 2)
  capacity    Int          @default(20)
  instructor  String       @db.VarChar(191)
  status      CourseStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy    User?         @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  certificates Certificate[]

  @@index([courseCode])
  @@index([status])
}

model Enrollment {
  id              String           @id @default(uuid())
  studentId       String
  courseId        String
  status          EnrollmentStatus @default(PENDING)
  progressPercent Int              @default(0)
  enrolledAt      DateTime         @default(now())
  reviewedById    String?
  reviewedAt      DateTime?
  notes           String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  reviewedBy  User?        @relation("EnrollmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  certificate Certificate?

  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

model Certificate {
  id                String            @id @default(uuid())
  certificateNumber String            @unique @db.VarChar(100)
  studentId         String
  courseId          String
  enrollmentId      String            @unique
  issueDate         DateTime          @default(now())
  issuedById        String
  status            CertificateStatus @default(VALID)
  templateData      String?           @db.Text
  filePath          String?           @db.VarChar(255)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  issuedBy   User       @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([certificateNumber])
  @@index([studentId])
  @@index([courseId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.VarChar(100)
  metadata    String?  @db.Text
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}
